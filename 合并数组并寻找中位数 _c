double findMedianSortedArrays(int* nums1, int nums1Size, int* nums2, int nums2Size)
{
    int s = nums1Size + nums2Size;
    int* ans = (int*)malloc(s * sizeof(int));
    int i, j;

    // 第一步：复制nums1到ans，i < nums1Size ！！
    for(i = 0; i < nums1Size; i++)
    {
        ans[i] = nums1[i];
    }
    // 第二步：复制nums2，从ans的 nums1Size 位置开始放
    for(j = 0; j < nums2Size; j++)
    {
        ans[nums1Size + j] = nums2[j];
    }

    // 冒泡排序整个ans数组
    int k, m, temp;
    for(k = 0; k < s - 1; k++)
    {
        for(m = 0; m < s - 1 - k; m++)
        {
            if(ans[m] > ans[m+1])
            {
                temp = ans[m];
                ans[m] = ans[m+1];
                ans[m+1] = temp;
            }
        }
    }

    double res;
    if(s % 2 == 1)
    {
        res = ans[s / 2];
    }
    else
    {
        res = (ans[s/2 - 1] + ans[s/2]) / 2.0;
    }
    free(ans);
    return res;
}
