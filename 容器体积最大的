//这题的逻辑是双指针
int maxArea(int* height, int heightSize)
{
    int left;
    int right;
    int maxarea;
    int h;
    int area;

    left = 0;
    right = heightSize - 1;
    maxarea = 0;

    while(left < right)
    {
        // 取矮的柱子作为水位高度
        h = height[left] < height[right] ? height[left] : height[right];
        area = h * (right - left);

        if(area > maxarea)
        {
            maxarea = area;
        }
        // 核心规则：移动更矮的那根
        if(height[left] < height[right])
        {
            left++;
        }
        else
        {
            right--;
        }
    }
    return maxarea;
}
