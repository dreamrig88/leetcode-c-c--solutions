int maxArea(int* height, int heightSize)
{
    int maxarea = 0;
    int i;
    int j;
    int h;
    int area;
    for(i = 0 ; i < heightSize; i++)
    {
        for(j = i + 1 ; j < heightSize; j++)
        {
            h = (height[i] < height[j]) ? height[i] : height[j];
            area = h * (j - i);
            if(area > maxarea)
            {
                maxarea = area;
            }
        }
    }
    return maxarea;
}
